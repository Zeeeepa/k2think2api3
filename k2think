#!/usr/bin/env bash
# K2Think Multi-Instance Manager - Unified CLI
# Usage: ./k2think <command> [args...]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANAGER_SCRIPT="$SCRIPT_DIR/k2think_manager.py"

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo "Error: python3 not found. Please install Python 3.7+"
    exit 1
fi

# Run manager script
python3 "$MANAGER_SCRIPT" "$@"

